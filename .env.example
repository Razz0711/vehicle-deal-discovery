# DealFinder environment template. Copy to .env.local and fill in.
# .env.local is git-ignored. Never commit real values, and never put them in this file.
#
# Every variable here is PUBLIC: NEXT_PUBLIC_* values are bundled into the browser.
# The Supabase secret key (sb_secret_...) and service_role key are NOT used by this app.
# They live only in Supabase Edge Function secrets. The app refuses to start if one is
# put in NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.

# local | staging | production
NEXT_PUBLIC_APP_ENV=local

# Staging: https://<staging-ref>.supabase.co  (see docs/STAGING.md)
# Local stack (supabase start): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Dashboard > Project Settings > API Keys > Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile site key. Only used by phone sign-in, which is paused (D3-13). Optional.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- SERVER-ONLY (never NEXT_PUBLIC_, never in browser code) ----
# This site's address, used for the Google sign-in return URL (/auth/callback).
# Leave empty on Vercel (VERCEL_URL is used); locally http://localhost:3000.
SITE_URL=http://localhost:3000

# Phone sign-in only (paused, D3-13). 64 hex characters. Must equal the Vault secret `otp_limiter_token` in the same Supabase project
# (docs/STAGING.md, "OTP limiter token"). Without it, code requests are refused (fail closed).
OTP_LIMITER_TOKEN=

# ---- Supabase CLI only (read by supabase/config.toml via env()); not used by Next.js ----
# Only needed if you enable CAPTCHA on the local stack.
# SUPABASE_AUTH_CAPTCHA_SECRET=
# Google sign-in on the local stack (Google Cloud OAuth client):
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
